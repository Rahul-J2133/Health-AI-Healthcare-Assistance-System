# Copy this file to .env and fill in your values. Never commit .env to git.

# ImageKit
IMAGEKIT_PUBLIC_KEY=public_
IMAGEKIT_PRIVATE_KEY=private_
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<imagekit_id>

# ThingSpeak
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_API_KEY=
THINGSPEAK_WRITE_API_KEY=

# Qdrant
QDRANT_URL=http://localhost:6333

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Pneumonia model — absolute path to your .h5 file
PNEUMONIA_MODEL_PATH=./models/pneumonia_pred_self.h5
# Directories
DATA_DIR=./data
PDF_OUTPUT_DIR=./generated_pdfs
WATCH_DIR=./data
